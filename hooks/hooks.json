{
  "description": "Skips the permission prompt for the md files tdd-subagent's agents use to communicate, under .tdd-subagent/.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/allow-tdd-artifact.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
